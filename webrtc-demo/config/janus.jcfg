general: {
    debug_level = 4
    session_timeout = 60
}
media: {
    rtp_port_range = "20000-20100"
}
plugins: {
    disable = "libjanus_voicemail.so,libjanus_audiobridge.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_streaming.so,libjanus_textroom.so,libjanus_videocall.so,libjanus_videoroom.so,libjanus_nosip.so,libjanus_lua.so,libjanus_duktape.so"
}
transports: {
    disable = "libjanus_websockets.so,libjanus_pfunix.so,libjanus_rabbitmq.so,libjanus_mqtt.so,libjanus_nanomsg.so"
}
